{
  "name": "rootnative-site",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/write-not-found-head.mjs && rootnative-seo dist --sitemap https://rootnative.github.io/sitemap.xml --sitemap https://rootnative.github.io/ui/sitemap.xml --sitemap https://rootnative.github.io/ui/demo/sitemap.xml --sitemap https://rootnative.github.io/inertia/sitemap.xml --sitemap https://rootnative.github.io/impulse/sitemap.xml && rootnative-seo audit dist",
    "browse:web": "rootnative-seo browse dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn lint && yarn typecheck && yarn format:check",
    "showcase:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-showcase.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:cards": "node scripts/build-cards.mjs"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@rootnative/components": "0.0.0-alpha.33",
    "@rootnative/core": "0.0.0-alpha.33",
    "@rootnative/inertia": "0.0.25",
    "@rootnative/seo": "0.0.0-alpha.33",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-native": "^5",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "~6.0.3"
  }
}
