{
  "name": "rootnative-site",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "yarn lint && yarn typecheck && yarn format:check",
    "build:icons": "node scripts/build-icons.mjs",
    "build:cards": "node scripts/build-cards.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@material/material-color-utilities": "^0.4.0",
    "@rootnative/components": "0.0.0-alpha.16",
    "@rootnative/core": "0.0.0-alpha.16",
    "@rootnative/inertia": "0.0.12",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-native": "^5",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "~6.0.3"
  }
}
